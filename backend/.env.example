DATABASE_URL=postgresql+psycopg2://kanban:kanban@localhost:5434/kanban
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Necessário para o e-mail de recuperação de senha funcionar. Sem
# RESEND_API_KEY, o envio é ignorado silenciosamente (útil em dev, mas o
# "esqueci minha senha" não entrega e-mail nenhum até isso ser configurado).
# Crie uma chave em https://resend.com/api-keys.
RESEND_API_KEY=
SMTP_FROM=no-reply@quadrosenai.local

FRONTEND_URL=http://localhost:3000
