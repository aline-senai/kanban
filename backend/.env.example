DATABASE_URL=postgresql+psycopg2://kanban:kanban@localhost:5434/kanban
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Necessário para os e-mails transacionais funcionarem: recuperação de senha, nova
# atividade atribuída e atividade que vence hoje. Sem SMTP_HOST, o envio é ignorado
# silenciosamente (útil em dev, mas nenhum desses e-mails é entregue até configurar).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@quadrosenai.local
SMTP_USE_TLS=true

FRONTEND_URL=http://localhost:3000

# Segredo compartilhado que protege POST /notificacoes/jobs/vencendo-hoje (header
# X-Cron-Secret). Essa rota dispara os e-mails de "vence hoje" e deve ser chamada 1x/dia
# por um agendador externo (cron do servidor, GitHub Actions com schedule, etc.) — vazio
# (padrão) desativa a rota. Gere um valor aleatório, ex: `openssl rand -hex 32`.
CRON_SECRET=
