DATABASE_URL=postgresql+psycopg2://kanban:kanban@localhost:5434/kanban
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Necessário para os e-mails transacionais funcionarem: recuperação de senha, nova
# atividade atribuída e atividade que vence hoje. Enviado via Gmail API (OAuth2,
# HTTPS — o Render bloqueia conexões SMTP de saída). Sem essas 4 variáveis, o
# envio é ignorado silenciosamente. Como gerar cada uma:
#   1. https://console.cloud.google.com/apis/credentials — crie um projeto,
#      ative a "Gmail API" e crie uma credencial OAuth 2.0 do tipo
#      "Aplicativo da Web" com o redirect URI
#      https://developers.google.com/oauthplayground → copie o Client ID e
#      o Client Secret gerados.
#   2. https://developers.google.com/oauthplayground → ícone de engrenagem
#      (canto superior direito) → marque "Use your own OAuth credentials" e
#      cole o Client ID/Secret do passo 1 → na lista de APIs à esquerda,
#      escolha "Gmail API v1" → escopo "https://www.googleapis.com/auth/gmail.send"
#      → "Authorize APIs" e faça login com a conta Gmail que vai enviar os
#      e-mails → "Exchange authorization code for tokens" → copie o Refresh
#      token gerado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=

FRONTEND_URL=http://localhost:3000

# Segredo compartilhado que protege POST /notificacoes/jobs/vencendo-hoje (header
# X-Cron-Secret). Essa rota dispara os e-mails de "vence hoje" e deve ser chamada 1x/dia
# por um agendador externo (cron do servidor, GitHub Actions com schedule, etc.) — vazio
# (padrão) desativa a rota. Gere um valor aleatório, ex: `openssl rand -hex 32`.
CRON_SECRET=
