DATABASE_URL=postgresql+psycopg2://kanban:kanban@localhost:5434/kanban
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Necessário para o e-mail de recuperação de senha funcionar. Sem SMTP_HOST, o
# envio é ignorado silenciosamente (útil em dev, mas o "esqueci minha senha"
# não entrega e-mail nenhum até isso ser configurado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@quadrosenai.local
SMTP_USE_TLS=true

FRONTEND_URL=http://localhost:3000
